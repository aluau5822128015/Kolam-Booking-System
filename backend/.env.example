# Copy to .env (which is gitignored) and fill in. Never commit real values.
PORT=5000
MONGODB_URI=<your MongoDB connection string>
# Long random string used to sign staff login tokens, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<long random secret>

# Allowed website origin(s), comma-separated, no wildcard. Defaults to http://localhost:5173 when unset.
# Production example: CORS_ORIGIN=https://your-site.vercel.app
CORS_ORIGIN=http://localhost:5173

# Guest chatbot AI (optional): Google Gemini. Get a free key at https://aistudio.google.com/apikey
# Without it, the chatbot still answers from the approved Kolam knowledge (no AI).
GEMINI_API_KEY=<your Gemini API key>
# Optional. Defaults to gemini-flash-lite-latest (Google's current Flash-Lite model, free tier).
# GEMINI_MODEL=gemini-flash-lite-latest
# Optional. How long a guest waits for Gemini before the built-in fallback answers (default 15000).
# GEMINI_TIMEOUT_MS=15000
